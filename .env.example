# Public Formspree (or compatible JSON POST) form URL.
# Create .env.local if missing; preserve any existing settings, then restart.
# Example URL shape: https://formspree.io/f/YOUR_FORM_ID
VITE_CONTACT_FORM_ENDPOINT=

# Public production origin, e.g. the deployed domain without a path.
# Generates canonical/social URLs and sitemap entries. Never put secrets here.
VITE_SITE_URL=

# Server-only Gemini settings. Never prefix these with VITE_.
# Get your own key from Google AI Studio and store it only in .env.local.
GEMINI_API_KEY=
# Choose an available Gemini text model ID in AI Studio. No default is used.
GEMINI_MODEL=
